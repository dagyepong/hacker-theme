{{!< default}}

<div class="post-feed">
    {{#author}}
    <div style="margin-bottom: 2.5rem; border-left: 2px solid var(--highlight-color); padding-left: 1rem;">
        <div class="system-status">&gt; cat /etc/passwd/author_{{slug}}</div>
        <h1 class="post-title" style="font-size: 1.5rem; margin: 0.5rem 0;">{{name}}</h1>
        {{#if bio}}
        <p class="post-excerpt" style="margin-bottom: 0.75rem;">{{bio}}</p>
        {{/if}}
        <div class="post-meta">
            {{#if location}}[location: {{location}}]{{/if}}
            {{#if website}}[web: <a href="{{website}}" target="_blank" style="text-decoration: underline;">{{website}}</a>]{{/if}}
        </div>
    </div>
    {{/author}}

    <hr class="terminal-rule">
    <div class="system-status">&gt; find ./posts --author=match</div>

    {{#foreach posts}}
    <article class="post-card {{post_class}}">
        <div class="post-meta">
            <span class="post-date">[{{date format="YYYY-MM-DD"}}]</span>
        </div>
        <h2 class="post-title">
            <a href="{{url}}">&gt; {{title}}</a>
        </h2>
        {{#if excerpt}}
            <p class="post-excerpt">{{excerpt words="25"}}...</p>
        {{/if}}
    </article>
    {{/foreach}}

    <div style="margin-top: 3rem;">
        <a href="{{@site.url}}" class="contact-prompt">&gt; cd .. (back to root)</a>
    </div>
</div>