{{!< default}}

{{#post}}
<article class="single-post {{post_class}}">
    <header class="post-header">
        <p class="back-link"><a href="{{@site.url}}">&lt; cd ..</a></p>
        <span class="post-meta">[{{date format="YYYY-MM-DD"}}]</span>
        <h1>{{title}}</h1>
    </header>

    <div class="post-content">
        {{content}}
    </div>
</article>
{{/post}}