{{!< default}}

{{#page}}
<article class="single-post {{post_class}}">
    <header class="post-header">
        <p class="back-link"><a href="{{@site.url}}">&lt; cd ..</a></p>
        {{#match @page.show_title_and_feature_image}}
            <h1>{{title}}</h1>
        {{/match}}
    </header>

    <div class="post-content">
        {{content}}
    </div>
</article>
{{/page}}