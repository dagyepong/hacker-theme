{{!< default}}

<div class="post-feed">
    <div class="feed-header">
        <p class="system-status">CONNECTION: ESTABLISHED // ENCRYPTION: SHA-256 // ACCESS: ROOT@HOMELAB // WARNING: NO ANOMALIES</p>
        <hr class="terminal-rule">
    </div>

    {{#foreach posts}}
        <article class="post-card {{post_class}}">
            <div class="post-meta">
                <span class="post-date">[{{date format="YYYY-MM-DD"}}]</span>
            </div>
            <h2 class="post-title">
                <a href="{{url}}">&gt; {{title}}</a>
            </h2>
            <p class="post-excerpt">{{excerpt characters="120"}}...</p>
        </article>
    {{/foreach}}
</div>

{{pagination}}

