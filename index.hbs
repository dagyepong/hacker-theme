{{!< default}}

<div class="post-feed">
    <div class="feed-header">
        <p class="system-status">CONNECTION: ESTABLISHED // ENCRYPTION: SHA-256 // ACCESS: ROOT@HOMELAB // WARNING: NO ANOMALIES</p>
        <hr class="terminal-rule">
    </div>

    {{#foreach posts}}
        <article class="post-card {{post_class}}">
            <div class="post-meta">
                <span class="post-date">[{{date format="YYYY-MM-DD"}}]</span>
                {{#if tags}}
                    <span class="post-tags">
                        {{#foreach tags}}
                            <a href="{{url}}" class="terminal-tag" title="{{name}}">--tag={{slug}}</a>{{^last}} {{/last}}
                        {{/foreach}}
                    </span>
                {{/if}}
            </div>
            <h2 class="post-title">
                <a href="{{url}}">&gt; {{title}}</a>
            </h2>
            <p class="post-excerpt">{{excerpt characters="120"}}...</p>
        </article>
    {{/foreach}}
</div>

{{pagination}}

<div class="terminal-contact-section">
    <hr class="terminal-rule">

    <!-- Author Bio / System Profile Manifest -->
    <div class="contact-block" style="margin-bottom: 2rem;">
        <p class="contact-prompt">&gt; cat /etc/passwd/nana --bio</p>
        <div class="post-excerpt" style="margin-top: 0.8rem; line-height: 1.6; color: var(--text-color);">
            <p style="color: var(--highlight-color); font-weight: bold; margin-bottom: 0.5rem;">
                Security Analyst. Self-hoster. Automator.
            </p>
            <p style="margin-bottom: 1rem;">
                I’m nana, a Cyber Security Analyst with a passion for self-hosting. I spend my time diving into the weeds of Docker, Kubernetes, and home lab security. I started this blog to share my technical experiments, configuration guides, and security best practices.
            </p>
            
            <p style="color: var(--highlight-color); margin-bottom: 0.3rem;">&gt; cat /etc/security/philosophy.conf</p>
            <ul style="list-style-type: none; padding-left: 1rem; margin-bottom: 1rem; color: var(--dim-color);">
                <li><span style="color: var(--text-color);">[01]</span> Principle of Least Privilege: Minimum permissions, isolated processes.</li>
                <li><span style="color: var(--text-color);">[02]</span> Zero Trust Networking: Hostile network assumption, Tailscale, authenticated proxies.</li>
                <li><span style="color: var(--text-color);">[03]</span> Immutable Infrastructure: Version-controlled configs, minimized drift.</li>
                <li><span style="color: var(--text-color);">[04]</span> Secrets Hygiene: Centralized secret management, zero plain-text keys.</li>
            </ul>
            
            <p style="font-size: 0.9em; color: var(--dim-color); font-style: italic;">
                "In the world of self-hosting, security is a process, not a destination."
            </p>
        </div>
    </div>

    <!-- Active System Users Manifest -->
    <div class="contact-block" style="margin-bottom: 2rem;">
        <p class="contact-prompt">&gt; cat /etc/passwd --active-users</p>
        {{#get "authors" limit="all" include="count.posts"}}
            <ul class="contact-links" style="margin-top: 0.5rem;">
                {{#foreach authors}}
                    <li style="margin-bottom: 0.3rem;">
                        <span class="key">user[{{slug}}]:</span> 
                        <a href="/about/" style="text-decoration: underline;">{{name}}</a> 
                        <span style="color: var(--dim-color);">({{count.posts}} posts)</span>
                    </li>
                {{/foreach}}
            </ul>
        {{/get}}
    </div>

